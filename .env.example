# ─────────────────────────────────────────────────────────────
# Alento — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (o docker-compose.yml sobe exatamente este banco)
DATABASE_URL="postgresql://alento:alento@localhost:5432/alento"

# Banco usado apenas pelos testes de integração (é APAGADO a cada execução!)
TEST_DATABASE_URL="postgresql://alento:alento@localhost:5432/alento_test"

# Conexões simultâneas por instância do app (opcional)
# DATABASE_POOL_MAX="10"

# Chave AES-256 (32 bytes em base64) que criptografa prontuários, dados de
# saúde do paciente e mensagens do chat. Gere a sua com:  npm run generate:key
# NUNCA reutilize a chave de exemplo em produção e NUNCA a perca:
# sem ela, os dados criptografados não podem ser lidos. Guarde num cofre de segredos.
ENCRYPTION_KEY="troque-por-uma-chave-gerada-com-npm-run-generate-key"

# URL pública do site (usada em links, sitemap e metadados)
APP_URL="http://localhost:3000"

# E-mails transacionais (convites de profissionais, "esqueci minha senha",
# aviso de senha alterada e de consulta cancelada). Qualquer provedor com SMTP:
#   smtps://USUARIO:SENHA@smtp.seuprovedor.com:465
#   smtp://USUARIO:SENHA@smtp.seuprovedor.com:587
# Sem SMTP_URL: em desenvolvimento os e-mails aparecem no terminal do servidor;
# em produção NADA é enviado (e o servidor avisa ao iniciar).
# SMTP_URL=""
# Remetente (use um domínio seu com SPF, DKIM e DMARC configurados).
# MAIL_FROM="Alento <nao-responda@seudominio.com.br>"

# Quantos proxies confiáveis ficam na frente do app (hospedagem, nginx, CDN).
# Usado para descobrir o IP real do cliente no limite de tentativas de login.
# TRUSTED_PROXY_HOPS="1"

# O "npm run db:seed" só roda em banco local. Para recriar uma DEMONSTRAÇÃO
# num banco remoto (nunca o de produção), defina como "true".
# SEED_ALLOW_REMOTE="false"

# Mostra as contas de demonstração na tela de entrada.
# Use "true" só em desenvolvimento ou numa demonstração. Em produção: "false".
DEMO_MODE="true"

# Produção com mais de uma instância (ou self-hosting): chave estável para as
# Server Actions. Gere com:  openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# O fuso horário da agenda fica em src/config/clinic.ts (America/Sao_Paulo).
